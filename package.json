{
  "name": "lex",
  "version": "0.1.0",
  "private": true,
  "description": "Cyprus-VAT-compliant invoicing platform for lawyers — bilingual GR+EN, AI-assisted, trust-ledger-aware",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:cache-integrity": "node scripts/check-demo-cache-integrity.mjs",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:test": "npx supabase db reset && bash supabase/tests/run.sh",
    "test:ai-injection": "DEMO_CACHE=true tsx tests/ai-injection.mjs",
    "test:ai-preflight": "DEMO_CACHE=true node tests/ai-preflight.mjs",
    "test:ai-concurrent": "DEMO_CACHE=true node tests/ai-concurrent-finalize.mjs",
    "test:smoke": "DEMO_CACHE=true node tests/smoke.mjs",
    "test:all": "npm run test:ai-injection && npm run test:ai-preflight && npm run test:ai-concurrent && npm run test:smoke"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-intl": "^4.11.2",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
