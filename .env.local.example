# Lex — local environment template
# Copy this file to .env.local and fill the values.
# `vercel env pull` will overwrite .env.local once linked to Vercel.

# -----------------------------------------------------------------------------
# Supabase (EU region — Frankfurt or Ireland)
# -----------------------------------------------------------------------------
# Local: `npx supabase status -o env` prints these after `npx supabase start`.
# Cloud: pull from Supabase Studio → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER expose this in client components or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Local-only — direct Postgres URL for psql + seed scripts.
# Default for `npx supabase start`: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# AI — OpenRouter (routes to Mistral / Anthropic / etc.)
# -----------------------------------------------------------------------------
# Ask Fawzi for a key if you don't have one. Prefer EU-routed models (Mistral)
# for Lex; document any US-routed model in the DPA.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-large-latest

# -----------------------------------------------------------------------------
# Email — Resend (transactional, magic-link, invoice attachments, reminders)
# -----------------------------------------------------------------------------
# Verified sending domain required for production. Free tier: 100/day, 3K/month.
# Resend transactional email — Phase 6 reminders. **Optional in development**
# (and intentionally NOT set in production per the locked 2026-05-13 decision
# documented in `OPERATOR.md` §11). When the key is absent the adapter at
# `src/lib/email/resend.ts` returns {status: "no_api_key"}, and the reminder
# UI on /reports/aging falls back to the DEMO_CACHE-rendered AI draft preview
# (no real email is sent). Set this only if you need to actually deliver
# transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=lex@qualiasolutions.cy

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Used in magic-link callback URL + email templates.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo-day cache for OpenRouter responses (avoid rate limits during pitch).
# Set to "true" only when running the demo; leave empty in development.
# **In production this MUST be `true`** — combined with RESEND_API_KEY being
# unset, this is what keeps the reminder UI offline-safe for the pitch.
# See OPERATOR.md §11 for the locked decision.
DEMO_CACHE=

# -----------------------------------------------------------------------------
# Vercel (auto-populated by `vercel link`)
# -----------------------------------------------------------------------------
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
